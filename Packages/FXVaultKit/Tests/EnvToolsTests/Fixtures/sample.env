# Synthetic sample for FX Vault tests. Every value is fake.
export APP_NAME=fx-sample
api-base-url=https://api.example.test/v1 # public endpoint
DATABASE_URL="postgres://sample_user:not-a-password@db.example.test:5432/app"
stripe_api_key='sample-key-value'
WELCOME_MESSAGE="Hello,\nWorld"

session.timeout=30
SIGNING_CERT_PEM="-----BEGIN CERTIFICATE-----\nMIIBsample\n-----END CERTIFICATE-----"
FEATURE_FLAGS=${OTHER_FLAGS}
GITHUB_TOKEN_NAME=deploy-bot
APP_NAME=fx-sample-override
